# macOS
.DS_Store
.AppleDouble
.LSOverride

# Rust
# Match any `target/` directory anywhere in the tree — covers the workspace
# root (`/target/`), per-crate (`/engine/target/`, `/units/target/`), and
# anything maturin creates under `python/target/` during a wheel build.
**/target/
**/*.dSYM/
**/*.rs.bk
Cargo.lock

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Apple / Swift FFI build products (M15) — regenerate with scripts/build-ios.sh.
# `build/` above already covers build/ios/ (bindgen output).
*.xcframework
*.generated.swift
.build/
.swiftpm/

# Kotlin / Android FFI build products (M16) — regenerate with
# scripts/build-android.sh. The whole generated-bindings package plus the
# cross-compiled .so trees stay out of git; the hand-written Gradle files
# and tests around them are committed. `build/` above already covers
# Gradle's per-module build/ directories, and `*.so` above covers the
# libraries themselves.
kotlin/VleThermo/src/main/kotlin/dev/
kotlin/VleThermo/src/main/jniLibs/
.gradle/
local.properties
# Gradle wrapper is generated locally (`gradle wrapper`), never committed —
# no binaries in the repo (the wrapper includes a .jar).
kotlin/gradle/
kotlin/gradlew
kotlin/gradlew.bat

# JavaScript / wasm FFI build products (M17) — regenerate with
# scripts/build-wasm.sh. wasm/pkg/ is the generated npm package (.wasm +
# JS glue + .d.ts); node_modules/ covers any JS project that consumes it
# from inside the tree.
wasm/pkg/
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Component database (generated by vle-db init + seed, not checked in)
data/components.db
data/components.db-wal
data/components.db-shm

# Claude Code
.claude/
!.claude/settings.json

#Deploy local
deploy/local/
deploy/.env
*.pem
*.key
