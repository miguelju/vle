#!/usr/bin/env bash
#
# vle pre-commit hook — documentation/reality sync gate.
#
# Enforces the mechanical half of CLAUDE.md's "Completion Claims Must Be
# Verified Against the Code — code is the fact". A plan document is a claim;
# the code is the fact. These checks compare the claims in ROADMAP.md,
# TODO.md and docs/plans/MODERNIZATION_PLAN.md against what is actually on
# disk, and
# block the commit when they disagree.
#
# Why pre-COMMIT and not pre-push. The equivalent Claude Code agent hook in
# .claude/settings.json fires on `git push`, which means it only ever sees a
# push that Claude itself runs — and it fires *after* a commit has already
# been written and signed. Commits here are made by a human at the keyboard
# (YubiKey touch), so the only place to catch a stale claim before it becomes
# history is here, in a real git hook that runs in whatever terminal is doing
# the committing.
#
# This hook is deliberately fast (pure Python, no cargo, no network) so it can
# run on every commit without being resented. The semantic checks a script
# cannot do — "does this prose still describe what the workflow does?" — stay
# with the agent hook on push, which acts as the second net.
#
# Activate with:  git config core.hooksPath hooks
# Never bypass with --no-verify. If a check is wrong, fix the check.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Only meaningful in the vle repo (the one carrying all three plan docs).
for f in ROADMAP.md TODO.md docs/plans/MODERNIZATION_PLAN.md; do
    [ -f "$f" ] || exit 0
done

PY=""
for cand in "$HOME/miniconda3/envs/vle/bin/python" python3 python; do
    if command -v "$cand" >/dev/null 2>&1 || [ -x "$cand" ]; then PY="$cand"; break; fi
done
if [ -z "$PY" ]; then
    echo "pre-commit: no python found — skipping doc-sync checks." >&2
    exit 0
fi

echo "pre-commit: doc/reality sync ..." >&2
"$PY" - "$@" <<'PYEOF'
import re, sys, pathlib

fail = []


def read(p):
    return pathlib.Path(p).read_text(encoding="utf-8")


roadmap, todo, plan = read("ROADMAP.md"), read("TODO.md"), read("docs/plans/MODERNIZATION_PLAN.md")

# ---------------------------------------------------------------- check 1
# Milestone headers must correspond 1:1 between ROADMAP.md and TODO.md.
# Sub-milestones (7.1, 12.3, ...) count separately; a milestone that exists in
# one file and not the other is the classic way work goes unrecorded.
def milestones(text):
    out = set()
    for m in re.finditer(r"^#{2,3}\s+Milestone\s+(\d+(?:\.\d+)?)", text, re.M):
        out.add(m.group(1))
    return out


r_ms, t_ms = milestones(roadmap), milestones(todo)
if r_ms - t_ms:
    fail.append(f"milestones in ROADMAP.md but not TODO.md: {sorted(r_ms - t_ms)}")
if t_ms - r_ms:
    fail.append(f"milestones in TODO.md but not ROADMAP.md: {sorted(t_ms - r_ms)}")

# ---------------------------------------------------------------- check 2
# Every `*Phase N of MODERNIZATION_PLAN.md*` pointer must resolve to a real
# phase header. Ranges ("Phases 7-9") must resolve at both ends.
phase_headers = set(
    m.group(1) for m in re.finditer(r"^#{2,3}\s+Phase\s+(\d+)", plan, re.M)
)
for m in re.finditer(r"\*Phases?\s+([\d\s,–—-]+?)\s+of\s+MODERNIZATION_PLAN\.md\*", roadmap):
    nums = re.findall(r"\d+", m.group(1))
    for n in nums:
        if n not in phase_headers:
            fail.append(f"ROADMAP.md points at Phase {n}, which has no header in MODERNIZATION_PLAN.md")

# ---------------------------------------------------------------- check 3
# No stale fractional milestone references that no longer exist as headers.
for m in re.finditer(r"Milestone\s+(\d+\.\d+)", roadmap + todo):
    if m.group(1) not in (r_ms | t_ms):
        fail.append(f"reference to Milestone {m.group(1)}, which has no section in either file")
        break

# ---------------------------------------------------------------- check 4
# Every notebook on disk must be named somewhere in ROADMAP.md or TODO.md.
# This is the check that would have caught notebooks/14_pvt_surface.ipynb,
# which shipped in 972c28b and went unrecorded in both files for two weeks.
nb_dir = pathlib.Path("notebooks")
if nb_dir.is_dir():
    notebooks = sorted(
        p.name for p in nb_dir.glob("*.ipynb") if p.name != "index.ipynb"
    )
    for nb in notebooks:
        if nb not in roadmap and nb not in todo:
            fail.append(f"notebooks/{nb} exists on disk but is named in neither ROADMAP.md nor TODO.md")

    # ------------------------------------------------------------ check 5
    # Any "<N> notebooks" claim must match the real count. Past-tense,
    # milestone-scoped phrasing ("15 that existed at M11", "then-15-notebook")
    # is exempt: it is a record of history, not a claim about today.
    n = len(notebooks)
    # Match only the PLURAL, space-separated form — that is how a real count
    # claim is always written ("19 notebooks", "19 executable notebooks"), and
    # requiring it sidesteps two classes of false positive found the hard way:
    #   - version strings   "Create v0.3.0 notebook"  (singular)
    #   - historical adjectives "the then-15-notebook collection" (singular,
    #     hyphenated, and deliberately scoped to the past)
    # `\s+` spans newlines on purpose: the claim this check first caught was
    # line-wrapped as "20 executable\nnotebooks", which a line-oriented grep
    # walked straight past.
    COUNT = re.compile(r"(?<![.\d])(\d{1,3})\s+(?:executable\s+)?notebooks\b")
    HISTORICAL = re.compile(r"then-|that existed|then[\s-]existing|at M\d+")
    for doc in ("README.md", "python/README.md", "distribution/NOTEBOOKS.md", "ROADMAP.md", "TODO.md"):
        if not pathlib.Path(doc).is_file():
            continue
        text = read(doc)
        for m in COUNT.finditer(text):
            claimed = int(m.group(1))
            if claimed == n:
                continue
            # Past-tense, milestone-scoped records are exempt; look at the
            # preceding clause, not just the matched span.
            if HISTORICAL.search(text[max(0, m.start() - 80):m.end()]):
                continue
            fail.append(
                f"{doc}: claims '{' '.join(m.group(0).split())}' but {n} notebooks exist "
                f"(if it is a past-tense record, scope it — e.g. 'the then-{claimed}')"
            )

if fail:
    print("\nABORT: documentation does not match the repository.\n", file=sys.stderr)
    for f in fail:
        print(f"  - {f}", file=sys.stderr)
    print(
        "\nCLAUDE.md: a plan document is a claim; the code is the fact.\n"
        "Fix the docs (or the check, if the check is wrong) and commit again.\n"
        "Do not use --no-verify.\n",
        file=sys.stderr,
    )
    sys.exit(1)
PYEOF

echo "pre-commit: docs in sync." >&2
exit 0
