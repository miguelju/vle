# VLE deployment — environment template.
#
# Copy this file to deploy/.env and fill in real values:
#     cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored. Never commit it.

# ---- Networking ------------------------------------------------------------

# Public hostname. The reverse proxy (Traefik) will route requests for this
# host to JupyterHub. Must resolve to the server's public IP.
DOMAIN=vle.example.com

# Name of the pre-existing external Docker network that the reverse proxy
# lives on. The compose file attaches JupyterHub to this network so Traefik
# can reach it. Create it once with:
#     docker network create web
TRAEFIK_NETWORK=web

# ---- Authentication --------------------------------------------------------

# "oidc" (production, recommended): OpenID Connect against a self-hosted
#   identity provider such as Pocket ID. The hub redirects unauthenticated
#   users to the provider. Requires the OIDC_* vars below.
# "cloudflare" (legacy): trust the Cf-Access-Authenticated-User-Email
#   header set by Cloudflare Access. Only safe if the hub is unreachable
#   except through the Cloudflare -> reverse-proxy path.
# "dummy" (local dev): accept any username/password. NEVER use on a public
#   host.
AUTH_MODE=oidc

# Your Cloudflare Access team domain, e.g. acme.cloudflareaccess.com.
# Only used when AUTH_MODE=cloudflare. Leave as a placeholder otherwise.
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com

# Email address granted JupyterHub admin privileges. Must match the email
# that the active authenticator reports for you (Cloudflare Access email,
# or the OIDC `email` claim).
JUPYTERHUB_ADMIN_EMAIL=admin@example.com

# ---- OIDC / Pocket ID ------------------------------------------------------
# Only consumed when AUTH_MODE=oidc.

# Base URL of your Pocket ID (or other OIDC provider) instance. No trailing slash.
OIDC_ISSUER=https://id.example.com

# OAuth client credentials issued by Pocket ID when you register the JupyterHub
# application. Treat OIDC_CLIENT_SECRET like a password.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Where Pocket ID redirects the browser after a successful login. Must be
# registered as an allowed redirect URI in Pocket ID and match exactly,
# including scheme and trailing path. JupyterHub serves this route by default.
OAUTH_CALLBACK_URL=https://vle.example.com/hub/oauth_callback

# Endpoint overrides — optional. Leave blank to use Pocket ID defaults
# derived from OIDC_ISSUER:
#   authorize: ${OIDC_ISSUER}/authorize
#   token:     ${OIDC_ISSUER}/api/oidc/token
#   userinfo:  ${OIDC_ISSUER}/api/oidc/userinfo
# Set these only when pointing at a non-Pocket-ID OIDC provider whose paths differ.
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# Claim used as the JupyterHub username. "email" is the safe default and
# matches JUPYTERHUB_ADMIN_EMAIL above. Use "preferred_username" if you'd
# rather key on Pocket ID usernames.
OIDC_USERNAME_CLAIM=email

# OIDC scopes requested at login. Must include "openid". "email" is needed
# for the email claim; "profile" is needed if you switch the username claim.
OIDC_SCOPES=openid email profile

# Label shown on the JupyterHub "Sign in with ..." button.
OIDC_LOGIN_SERVICE=Pocket ID

# ---- Cloudflare Tunnel (optional) ------------------------------------------

# If set, the compose stack also starts a `cloudflared` container that
# terminates a Cloudflare Tunnel and forwards to Traefik over the internal
# `web` network. This lets you run without exposing any public ports on the
# host. Leave empty if you terminate TLS / ingress yourself.
# Create the tunnel in the Cloudflare Zero Trust dashboard and paste the
# connector token here.
CLOUDFLARED_TUNNEL_TOKEN=

# ---- Per-user notebook resource limits -------------------------------------

# Memory ceiling for each user's notebook container. Docker syntax: 512m, 1g.
CONTAINER_MEM_LIMIT=512m

# CPU ceiling for each user's notebook container. Fractional cores allowed.
CONTAINER_CPU_LIMIT=0.5

# How long a user's server can sit idle before the culler stops it.
IDLE_TIMEOUT_MINUTES=15

# ---- Images ----------------------------------------------------------------

# Tag to apply to the single-user notebook image. DockerSpawner uses this tag
# when launching per-user containers, so it must match whatever is built from
# deploy/docker/Dockerfile.notebook.
NOTEBOOK_IMAGE=vle-notebook:latest

# OPTIONAL: enable live notebook updates without image rebuilds. Set this to
# the absolute HOST path of your checked-out repo's notebooks/ directory (e.g.
# /home/deploy/vle/notebooks). When set, per-user spawns get a read-only
# bind-mount of that path at /opt/vle/notebooks, and CI's
# `deploy-sandbox-notebooks` workflow can refresh notebooks in seconds via
# deploy/scripts/deploy-notebooks.sh — no docker build, no stack restart. New
# spawns see the latest content immediately; existing user volumes re-seed
# when /opt/vle/notebooks/.notebook-version changes.
# Leave EMPTY to use only the image-bundled notebooks (legacy behavior:
# every refresh requires a full image rebuild via deploy/scripts/deploy.sh).
NOTEBOOK_HOST_PATH=

# ---- Component database (optional) -----------------------------------------

# Path to the SQLite component database INSIDE the spawned container.
# Defaults (set by Dockerfile.notebook) to /home/jovyan/work/data/components.db
# so users get their own editable copy seeded from the image at first login.
# Override only if you mount the DB from a different path.
# VLE_DB_PATH=/home/jovyan/work/data/components.db
